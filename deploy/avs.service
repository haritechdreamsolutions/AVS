[Unit]
Description=AVS billing application
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=avs
Group=avs
WorkingDirectory=/opt/avs
EnvironmentFile=/etc/avs/app.env
Environment=NODE_OPTIONS=--max-old-space-size=512
ExecStart=/usr/bin/node /opt/avs/backend/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
MemoryMax=768M
TasksMax=128
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
