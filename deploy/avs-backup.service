[Unit]
Description=AVS encrypted hourly offsite PostgreSQL backup
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=avs-backup
Group=avs-backup
WorkingDirectory=/opt/avs
EnvironmentFile=/etc/avs/backup.env
Environment=TZ=Asia/Kolkata
ExecStart=/bin/sh /opt/avs/deploy/backup.sh
Restart=on-failure
RestartSec=60
TimeoutStopSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
MemoryMax=256M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
