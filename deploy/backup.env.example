PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=avs_agencies_db
PGUSER=avs_backup
PGPASSFILE=/etc/avs/backup.pgpass
PGOPTIONS="-c timezone=Asia/Kolkata"
RCLONE_CONFIG=/etc/avs/rclone.conf
BACKUP_RECIPIENT=REPLACE_WITH_PUBLIC_AGE_RECIPIENT
BACKUP_REMOTE=offsite:REPLACE_WITH_BUCKET/prefix
BACKUP_HEARTBEAT_URL=https://REPLACE_WITH_EXTERNAL_BACKUP_MONITOR
