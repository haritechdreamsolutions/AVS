# ==============================================================================
# AVS Agencies - Environment Variables Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=5000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/avs_agencies_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=avs_agencies_db

# Session Secret (change this to a secure random string in production)
SESSION_SECRET=avs_production_super_secret_session_key_replace_in_prod

# Client & API URLs (for CORS and test runner)
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:5000
