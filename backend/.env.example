PORT=5000
PG_HOST=localhost
PG_PORT=5432
PG_USER=your_pg_user
PG_PASSWORD=your_pg_password
PG_DATABASE=avs_agencies_db
# Or use DATABASE_URL:
# DATABASE_URL=postgresql://user:password@host:5432/avs_agencies_db

SESSION_SECRET=change_this_to_a_long_random_string_in_production

# Bootstrap credentials (only used on first run)
BOOTSTRAP_COMPANY_NAME=Your Company Name
BOOTSTRAP_OWNER_LOGIN=owner
BOOTSTRAP_OWNER_NAME=Owner Admin
BOOTSTRAP_OWNER_PIN=change_this_immediately
BOOTSTRAP_OWNER_PHONE=

FRONTEND_URL=http://localhost:4000
NODE_ENV=development
